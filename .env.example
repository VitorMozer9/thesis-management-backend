# Modelo do ambiente de desenvolvimento. Use infrastructure/setup_dev.py para gerar os segredos.
# Preserve as credenciais ao reutilizar volumes existentes.
POSTGRES_DB=thesis_db
POSTGRES_USER=thesis_user
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5434

# Os serviços Docker usam postgres:5432, redis:6379 e kafka:19092.
# Os endereços abaixo são para execução Python no host.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TEST_URL=redis://127.0.0.1:6379/15
IDENTITY_REDIS_URL=redis://127.0.0.1:6379/1
REPOSITORY_REDIS_URL=redis://127.0.0.1:6379/2
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_THESIS_EVENTS_TOPIC=thesis.events.v1
KAFKA_PDF_GROUP_ID=thesis-pdf-extraction-v1
DEFENSE_KAFKA_TOPIC=defense.events.v1
REPOSITORY_PUBLICATION_TOPIC=repository.events.v1
REPOSITORY_KAFKA_GROUP=repository-publication-v1
REPOSITORY_CACHE_TTL=120
NOTIFICATION_KAFKA_GROUP=notification-delivery-v1
NOTIFICATION_KAFKA_OFFSET_RESET=latest

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,thesis-api
THESIS_API_PORT=8001
# O limite de 20 MiB por PDF é fixo no serviço. O Nginx aceita 21 MiB por requisição multipart.
# Cotas por conta e por janela, compartilhadas entre réplicas pelo Redis.
THESIS_RATE_WINDOW_SECONDS=60
THESIS_UPLOAD_LIMIT=10
THESIS_SUBMIT_LIMIT=5

IDENTITY_SECRET_KEY=
IDENTITY_DEBUG=False
IDENTITY_ALLOWED_HOSTS=localhost,127.0.0.1,identity-api
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=
IDENTITY_DB_HOST=127.0.0.1
IDENTITY_DB_PORT=5434
IDENTITY_API_PORT=8002
IDENTITY_ACCESS_TOKEN_TTL_SECONDS=300
IDENTITY_MAX_ASSIGNABLE_ADVISORS=100
IDENTITY_LOGIN_FAILED_RATE=10/m/ip,5/5m/key

# Emissor e audiência devem coincidir. Defesa, repositório e notificações herdam os valores do Identity no Compose.
IDENTITY_JWT_ISSUER=urn:tcc:identity
IDENTITY_JWT_AUDIENCE=urn:tcc:api
THESIS_JWT_ISSUER=urn:tcc:identity
THESIS_JWT_AUDIENCE=urn:tcc:api
# Caminhos absolutos no host, fora do Git. O Compose monta a privada apenas no Identity.
IDENTITY_JWT_PRIVATE_KEY_HOST_FILE=
THESIS_JWT_PUBLIC_KEY_HOST_FILE=
# Alternativas para execução Python no host.
IDENTITY_JWT_PRIVATE_KEY_FILE=
THESIS_JWT_PUBLIC_KEY_FILE=
THESIS_JWT_PUBLIC_KEY=

DEFENSE_SECRET_KEY=
DEFENSE_DB_PASSWORD=
DEFENSE_API_PORT=8003

REPOSITORY_SECRET_KEY=
REPOSITORY_DB_PASSWORD=
REPOSITORY_API_PORT=8004
# Credencial entre Repository e Defense.
REPOSITORY_VERIFICATION_KEY=

NOTIFICATION_SECRET_KEY=
NOTIFICATION_DB_PASSWORD=
NOTIFICATION_API_PORT=8005
# Quatro credenciais distintas para consultar as APIs internas.
NOTIFICATION_THESIS_KEY=
NOTIFICATION_DEFENSE_KEY=
NOTIFICATION_IDENTITY_KEY=
NOTIFICATION_REPOSITORY_KEY=
NOTIFICATION_SMTP_HOST=mailpit
NOTIFICATION_SMTP_PORT=1025
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASSWORD=
NOTIFICATION_SMTP_TLS=false
NOTIFICATION_SMTP_TIMEOUT=10
NOTIFICATION_FROM_EMAIL=notificacoes@example.invalid
NOTIFICATION_MAX_ATTEMPTS=8
MAILPIT_PORT=8025

FRONTEND_PORT=8080
